---
// SVG 方框，最多三行置中文字。v 決定配色：acc（重點）/ red / grn / ghost（虛線）。
interface Props {
	x: number;
	y: number;
	w: number;
	h: number;
	v?: '' | 'acc' | 'red' | 'grn' | 'ghost';
	title?: string;
	sub?: string;
	sub2?: string;
}
const { x, y, w, h, v = '', title, sub, sub2 } = Astro.props;
const cx = x + w / 2;
const cy = y + h / 2;
const lines = [title, sub, sub2].filter(Boolean) as string[];
const offsets = lines.length === 1 ? [0] : lines.length === 2 ? [-10, 12] : [-20, 1, 20];
const tone = v === 'acc' || v === 'red' || v === 'grn' ? v : '';
---
<rect class={`box ${v}`} x={x} y={y} width={w} height={h} rx="8"></rect>
{
	lines.map((t, i) => (
		<text x={cx} y={cy + offsets[i]} class={i === 0 ? `tt ${tone}` : 'sm muted'} font-weight={i === 0 ? 600 : undefined}>
			{t}
		</text>
	))
}
