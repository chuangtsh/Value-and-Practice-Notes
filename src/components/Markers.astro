---
// 共用箭頭。各圖都放一份相同定義，同頁 id 重複也不影響結果。
---
<defs>
	<marker id="dg-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
		<path class="mk" d="M0,0 L10,5 L0,10 z"></path>
	</marker>
	<marker id="dg-a-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
		<path class="mk muted" d="M0,0 L10,5 L0,10 z"></path>
	</marker>
	<marker id="dg-a-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
		<path class="mk acc" d="M0,0 L10,5 L0,10 z"></path>
	</marker>
	<marker id="dg-a-red" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
		<path class="mk red" d="M0,0 L10,5 L0,10 z"></path>
	</marker>
	<marker id="dg-a-grn" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
		<path class="mk grn" d="M0,0 L10,5 L0,10 z"></path>
	</marker>
</defs>
